# Copiez ce fichier vers secrets.toml (local ou secrets Streamlit Cloud).

GEMINI_API_KEY = "votre-clé-google-ai"

# --- Persistance (obligatoire sur Streamlit Community Cloud) ---
# Sans cette section, la base SQLite locale est perdue à chaque mise en veille.
#
# Option A — stockage S3 ou compatible (Cloudflare R2, Backblaze B2, etc.)
#
# [persistence]
# provider = "s3"
# bucket = "mon-bucket"
# key = "mes-editos/editos_backup.tar.gz"
# region = "auto"
# endpoint_url = "https://xxxxxxxx.r2.cloudflarestorage.com"
# access_key_id = "xxxxxxxx"
# secret_access_key = "xxxxxxxx"
#
# Option B — fichier sur un volume durable (Docker, serveur perso)
#
# [persistence]
# provider = "file"
# backup_path = "/data/mes_editos_backup.tar.gz"
#
# Windows : n'utilisez PAS des backslashes « \ » entre guillemets doubles
# (ex. \Users est lu comme une séquence d'échappement et casse le fichier).
# Préférez les slashs « / » ou des guillemets simples :
#
# [persistence]
# provider = "file"
# backup_path = "C:/Users/Carl/Desktop/Mes Editos/mes_editos_backup.tar.gz"
# backup_path = 'C:\Users\Carl\Desktop\Mes Editos\mes_editos_backup.tar.gz'